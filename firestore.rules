rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function estaAutenticado() {
      return request.auth != null;
    }

    function perfilPropio() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    // Un usuario con `activo: false` no puede operar aunque tenga token vigente.
    function estaActivo() {
      return estaAutenticado() && perfilPropio().activo == true;
    }

    // Doble capa de la gestión de usuarios: además de ocultarse en la UI.
    function esAdmin() {
      return estaActivo() && perfilPropio().rol == 'admin';
    }

    function esMetodoPagoValido(metodo) {
      return metodo in [
        'efectivo_bs',
        'efectivo_usd',
        'pago_movil',
        'transferencia_bs',
        'zelle',
        'binance',
        'punto_venta'
      ];
    }

    // ---------- Usuarios ----------
    // Gestión exclusiva del admin; cada usuario puede leer su propio perfil
    // y cerrar únicamente su marca de contraseña temporal.
    match /usuarios/{uid} {
      allow get: if esAdmin() || (estaAutenticado() && request.auth.uid == uid);
      allow list: if esAdmin();
      allow create: if esAdmin();
      allow update: if esAdmin() || (
        estaActivo() &&
        request.auth.uid == uid &&
        (
          // Cierre del cambio obligatorio de contraseña temporal.
          (
            ('debeCambiarContrasena' in resource.data) &&
            resource.data.debeCambiarContrasena == true &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['debeCambiarContrasena']) &&
            request.resource.data.debeCambiarContrasena == false
          ) ||
          // Cierre de la guía inicial. Los perfiles anteriores no tienen el campo.
          (
            (
              !('onboardingCompletado' in resource.data) ||
              resource.data.onboardingCompletado == false
            ) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['onboardingCompletado']) &&
            request.resource.data.onboardingCompletado == true
          )
        )
      );
      allow delete: if false;
    }

    // ---------- Configuración (tasa BCV) ----------
    // Caché de la tasa: lectura para usuarios activos; escritura validada.
    // La corrección manual (fuente 'manual') exige rol admin.
    match /configuracion/{docId} {
      allow get: if estaActivo();
      allow list: if false;
      allow create, update: if estaActivo() &&
        request.resource.data.valor is number && request.resource.data.valor > 0 &&
        request.resource.data.fechaActualizacion is timestamp &&
        (request.resource.data.fuente == 'dolarapi_oficial' || esAdmin());
      allow delete: if false;
    }

    // ---------- Baterías (inventario) ----------
    // Admin y usuario tienen permisos idénticos en inventario.
    match /baterias/{bateriaId} {
      allow read: if estaActivo();
      allow create, update: if estaActivo();
      allow delete: if false; // soft delete: nunca se borra físicamente
    }

    // ---------- Ventas ----------
    match /ventas/{ventaId} {
      allow read: if estaActivo();
      allow create: if estaActivo() &&
        request.resource.data.vendedor.uid == request.auth.uid &&
        request.resource.data.estado == 'completada' &&
        request.resource.data.total >= 0 &&
        request.resource.data.tasaBCV > 0 &&
        (
          // Las ventas anteriores a la Fase 9 no tienen `modalidadPago`.
          !('modalidadPago' in request.resource.data) ||
          request.resource.data.modalidadPago in ['contado', 'cashea', 'tienda']
        ) &&
        (
          // Una venta financiada exige cliente identificable y plan asociado.
          !('modalidadPago' in request.resource.data) ||
          request.resource.data.modalidadPago == 'contado' ||
          (
            request.resource.data.financiamientoId is string &&
            request.resource.data.financiamientoId.size() > 0 &&
            request.resource.data.cliente.nombre is string &&
            request.resource.data.cliente.nombre.size() > 0 &&
            request.resource.data.cliente.telefono is string &&
            request.resource.data.cliente.telefono.size() > 0
          )
        );
      // Solo anulación: cualquier usuario, con motivo obligatorio y auditoría.
      // Las ventas financiadas no se anulan; el admin puede eliminarlas.
      allow update: if estaActivo() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'anulacion']) &&
        request.resource.data.estado == 'anulada' &&
        request.resource.data.anulacion.motivo is string &&
        request.resource.data.anulacion.motivo.size() > 0 &&
        (
          !('modalidadPago' in resource.data) ||
          resource.data.modalidadPago == 'contado'
        );
      // El admin puede eliminar la venta; la app repone stock si estaba
      // completada y borra movimientos, financiamiento y pagos asociados.
      allow delete: if esAdmin();
    }

    // ---------- Financiamientos ----------
    // El plan se crea en la misma transacción que la venta. La forma del
    // documento se valida aquí; los montos se recalculan en el servicio.
    match /financiamientos/{financiamientoId} {
      allow read: if estaActivo();
      allow create: if estaActivo() &&
        request.resource.data.modalidad in ['cashea', 'tienda'] &&
        request.resource.data.estado == 'activo' &&
        request.resource.data.ventaId is string &&
        request.resource.data.ventaId.size() > 0 &&
        request.resource.data.numeroVenta is int &&
        request.resource.data.totalVenta > 0 &&
        request.resource.data.inicial >= 0 &&
        request.resource.data.inicial < request.resource.data.totalVenta &&
        request.resource.data.montoFinanciado > 0 &&
        request.resource.data.numeroCuotas is int &&
        request.resource.data.numeroCuotas > 0 &&
        request.resource.data.numeroCuotas <= 60 &&
        request.resource.data.diasEntreCuotas is int &&
        request.resource.data.diasEntreCuotas > 0 &&
        request.resource.data.cuotas is list &&
        request.resource.data.cuotas.size() == request.resource.data.numeroCuotas &&
        esMetodoPagoValido(request.resource.data.metodoPagoInicial);
      // Solo se actualizan campos derivados del cobro o de la liquidación.
      allow update: if estaActivo() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'cuotas',
          'cuotasPagadas',
          'saldoPendiente',
          'proximaCuotaNumero',
          'proximaFechaVencimiento',
          'estado',
          'liquidacion',
          'actualizadoEn'
        ]) &&
        request.resource.data.estado in ['activo', 'pagado', 'liquidado'];
      // El admin elimina el plan al eliminar la venta (borrado en cascada).
      allow delete: if esAdmin();

      // ---------- Pagos de un financiamiento ----------
      match /pagos/{pagoId} {
        allow read: if estaActivo();
        allow create: if estaActivo() &&
          request.resource.data.monto > 0 &&
          request.resource.data.montoBs > 0 &&
          request.resource.data.tasaBCV > 0 &&
          request.resource.data.cuotaNumero is int &&
          request.resource.data.cuotaNumero > 0 &&
          esMetodoPagoValido(request.resource.data.metodoPago) &&
          request.resource.data.anulacion == null;
        // La anulación no borra el pago: solo registra motivo y auditoría.
        allow update: if estaActivo() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['anulacion']) &&
          request.resource.data.anulacion.motivo is string &&
          request.resource.data.anulacion.motivo.size() > 0;
        allow delete: if esAdmin();
      }
    }

    // ---------- Pagos de financiamiento (consulta agregada) ----------
    // El módulo de financiamientos suma los cobros del mes con una consulta
    // de grupo (`collectionGroup("pagos")`). La regla con comodín recursivo
    // cubre cualquier ruta, porque la consulta se evalúa contra todos los
    // documentos de la colección, sin importar su financiamiento de origen.
    match /{ruta=**}/pagos/{pagoId} {
      allow read: if estaActivo();
    }

    // ---------- Movimientos (inmutables salvo eliminación del admin) ----------
    match /movimientos/{movimientoId} {
      allow read: if estaActivo();
      allow create: if estaActivo() &&
        request.resource.data.usuario.uid == request.auth.uid;
      allow update: if false;
      // Solo el admin puede eliminar movimientos. Si pertenecen a una venta,
      // la app los borra al eliminar la venta desde su flujo (con reposición
      // de stock); el historial no ofrece borrado directo para esos casos.
      allow delete: if esAdmin();
    }

    // ---------- Contadores ----------
    match /contadores/{contadorId} {
      allow get: if estaActivo();
      allow list: if false;
      allow update: if estaActivo() &&
        request.resource.data.valor == resource.data.valor + 1; // solo incrementos de 1
      allow create, delete: if false;
    }

    // ---------- Denegar todo lo demás ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
